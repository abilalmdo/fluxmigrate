---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import { phone, telHref } from "@/lib/contact";
import { markdownify } from "@/lib/utils/textConverter";

const cols = [
  { title: menu.footer_col_1_title, items: menu.footer_services },
  { title: menu.footer_col_2_title, items: menu.footer_company },
  { title: menu.footer_col_3_title, items: menu.footer_start },
  { title: menu.footer_col_4_title, items: menu.footer_legal },
];
---

<footer class="section pb-0 relative overflow-hidden">
  <div class="container pb-10">
    <!-- one grid, so every link column starts at the same height and the columns are evenly spaced:
         phone 2 x 2, tablet brand row + 4 columns, desktop brand + 4 columns on a single row -->
    <div class="grid grid-cols-2 gap-x-10 gap-y-10 md:grid-cols-4 xl:grid-cols-[minmax(0,2fr)_repeat(4,minmax(0,1fr))]">
      <div class="col-span-full max-w-95 text-lg text-text xl:col-span-1">
        <a href="/" class="inline-flex" aria-label={`${config.site.title} home`}>
          <img src={config.site.logo} width={Number(config.site.logo_width)} height={Number(config.site.logo_height)} alt="" loading="lazy" decoding="async" style={`height:${config.site.logo_height}px;width:auto`} />
        </a>
        <p class="mt-6">{config.params.footer_tagline}</p>
        <a class="link mt-6 inline-block underline" href={telHref}>{phone.display}</a>
        <p class="mt-1 text-base text-text-dark">{phone.hours}</p>
        <a class="link mt-4 inline-block underline" href={`mailto:${config.params.footer_email}`}>
          {config.params.footer_email}
        </a>
      </div>
      {
        cols.map((col) => (
          <div>
            <h3 class="footer-label">{col.title}</h3>
            <ul>
              {col.items.map((item) => (
                <li class="mb-4">
                  <a href={item.url} class="footer-link">{item.name}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <hr class="h-px bg-linear-to-r from-transparent from-25% via-white/50 to-75% to-transparent border-0" />
  <div class="container py-7">
    <p class="text-base text-text" set:html={markdownify(config.params.copyright)} />
  </div>
  <div
    class="absolute bottom-0 left-1/2 size-280 blur-2xl -translate-x-1/2 translate-y-1/2 -z-10"
    style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 30%, transparent) 0%, transparent 80%);"
  >
  </div>
</footer>
