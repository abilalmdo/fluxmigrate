---
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import { absolute, canonicalFor } from "@/lib/site";
import { plainify } from "@/lib/utils/textConverter";
import "@/styles/main.css";
import { Font } from "astro:assets";

const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** JSON-LD objects; rendered as separate <script type="application/ld+json"> blocks */
  schema?: object[];
}

const { title, meta_title, description, image, noindex, schema = [] } = Astro.props;

const pageTitle = plainify(meta_title || title || config.site.title);
const pageDescription = plainify(description || config.metadata.meta_description);
const canonical = canonicalFor(Astro.url.pathname);
const ogImage = absolute(image || config.metadata.meta_image);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={config.metadata.meta_author} />
    <meta name="generator" content={Astro.generator} />

    <!-- icons and manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={theme.colors.default.theme_color.body} />
    <meta name="color-scheme" content="dark" />

    <!-- fonts are self-hosted by Astro at build time -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- Open Graph / social preview -->
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FluxMigrate — cloud, DevOps, SRE and platform engineering" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      import "@/scripts/main.js";
      import "@/scripts/animations.js";
    </script>
  </body>
</html>
