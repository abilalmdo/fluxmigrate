---
import { optIn as o } from "@/data/content";
---

<!-- Newsletter opt-in (FM-108). A native <dialog>: the browser traps focus, closes on Escape and
     makes the page behind inert. main.js decides when to open it. Posts to our own /subscribe.php. -->
<dialog id="optin" class="optin" aria-labelledby="optin-title" aria-describedby="optin-text">
  <div class="optin-box">
    <button type="button" class="optin-close" data-optin-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <h2 id="optin-title" class="h4 pr-10">{o.title}</h2>
    <p id="optin-text" class="mt-3 text-text-dark">{o.text}</p>

    <form id="optin-form" action="/subscribe.php" method="POST" class="mt-6 grid gap-5">
      <input type="hidden" name="ts" value="" />
      <input type="hidden" name="page" value="" />
      <div class="hp-field" aria-hidden="true">
        <label for="optin-hp">Leave this field empty</label>
        <input id="optin-hp" name="hp_url" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div>
        <label class="field-label" for="optin-email">Email address</label>
        <input class="form-field" id="optin-email" name="email" type="email" maxlength="254" autocomplete="email" required />
      </div>

      <div id="optin-captcha-field" hidden>
        <label class="field-label" for="optin-captcha" id="optin-captcha-label">Security question</label>
        <input type="hidden" name="captcha_token" value="" />
        <input class="form-field" id="optin-captcha" name="captcha" type="text" maxlength="20" autocomplete="off" autocapitalize="off" spellcheck="false" />
      </div>

      <label class="optin-check">
        <input type="checkbox" name="consent" value="1" required />
        <span>{o.consent}</span>
      </label>

      <noscript>
        <p class="form-note">The spam check on this form needs JavaScript.</p>
      </noscript>

      <button type="submit" class="btn btn-primary w-full py-3 text-lg font-medium">{o.submit}</button>
      <p class="text-center text-sm">{o.note} <a class="link underline" href="/privacy-policy.html">{o.privacyLabel}</a></p>
    </form>

    <div id="optin-status" class="form-error mt-4" role="alert" tabindex="-1">
      We couldn't sign you up. Please check the form and try again.
    </div>
  </div>
</dialog>
