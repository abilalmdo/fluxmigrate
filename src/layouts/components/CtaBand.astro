---
import { markdownify } from "@/lib/utils/textConverter";
import Badge from "./Badge.astro";

interface Props {
  title: string;
  text: string;
  button: { label: string; href: string };
  badge?: string;
}
const { title, text, button, badge } = Astro.props;
---

<section class="section">
  <div class="container bg-light py-20 rounded-4xl corner-squircle relative overflow-hidden isolate">
    <div class="section-container">
      <div class="section-intro centralize">
        {badge && <Badge title={badge} />}
        <h2 class="title hasHighlight lg:col-9" set:html={markdownify(title)} />
        <p class="subtitle text-h6-sm lg:col-6">{text}</p>
        <a href={button.href} class="btn btn-primary mt-6">{button.label}</a>
      </div>
    </div>
    <div
      aria-hidden="true"
      class="absolute bottom-0 right-0 size-120 xl:size-280 blur-2xl translate-x-2/5 translate-y-1/2 -z-10"
      style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 60%, white) 0%, var(--color-primary) 10%, transparent 60%);"
    >
    </div>
    <div aria-hidden="true" class="absolute top-1/2 -translate-y-1/2 h-1/2 w-full overflow-hidden -z-10">
      <canvas class="heroSporeCanvas w-full"></canvas>
    </div>
  </div>
</section>
