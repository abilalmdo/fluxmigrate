---
import { consent as c } from "@/data/consent";
---

<!-- Consent banner (FM-705). Not modal, so the site stays usable; it is the first thing in the tab order.
     Hidden until consent.js finds no stored choice. "Reject non-essential" is as prominent as "Accept all". -->
<section id="consent-banner" class="consent-banner" aria-labelledby="consent-title" aria-describedby="consent-text" hidden>
  <h2 id="consent-title" class="h5">{c.title}</h2>
  <p id="consent-text" class="mt-2 text-base text-text-dark">
    {c.text}{" "}<a class="link underline" href="/cookie-policy.html">{c.policyLabel}</a>.
  </p>
  <div class="consent-actions">
    <button type="button" class="btn btn-primary btn-sm" data-consent="accept">{c.accept}</button>
    <button type="button" class="btn btn-primary btn-sm" data-consent="reject">{c.reject}</button>
    <button type="button" class="btn btn-outline btn-sm" data-consent="customize">{c.customize}</button>
  </div>
</section>

<dialog id="consent-prefs" class="optin consent-prefs" aria-labelledby="consent-prefs-title">
  <div class="optin-box">
    <button type="button" class="optin-close" data-consent="close" aria-label={c.close}>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <h2 id="consent-prefs-title" class="h4 pr-10">{c.prefsTitle}</h2>
    <p class="mt-3 text-text-dark">{c.prefsIntro}</p>
    <form id="consent-form" class="mt-6 grid gap-4">
      {
        c.categories.map((cat) => (
          <label class="consent-row">
            <input
              type="checkbox"
              name={cat.key}
              checked={cat.locked}
              disabled={cat.locked}
              aria-describedby={`consent-d-${cat.key}`}
            />
            <span>
              <span class="block font-semibold text-white">{cat.label}</span>
              <span id={`consent-d-${cat.key}`} class="block text-base text-text-dark">{cat.text}</span>
            </span>
          </label>
        ))
      }
      <div class="mt-2 grid gap-3 sm:grid-cols-2">
        <button type="submit" class="btn btn-primary btn-sm">{c.save}</button>
        <button type="button" class="btn btn-outline btn-sm" data-consent="accept">{c.accept}</button>
      </div>
      <button type="button" class="btn btn-outline btn-sm" data-consent="reject">{c.reject}</button>
    </form>
  </div>
</dialog>
