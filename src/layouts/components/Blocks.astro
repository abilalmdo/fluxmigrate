---
import type { Block } from "@/data/content";
import GradientBlob from "./GradientBlob.astro";
import Icon from "./Icon.astro";
import SectionIntro from "./SectionIntro.astro";
import Tabs from "./Tabs.astro";

interface Props {
  blocks: Block[];
}
const { blocks } = Astro.props;

const gridCols = (n: number = 3) =>
  ({
    2: "sm:grid-cols-2",
    3: "sm:grid-cols-2 lg:grid-cols-3",
    4: "sm:grid-cols-2 xl:grid-cols-4",
  })[n as 2 | 3 | 4];
---

{
  blocks.map((block, i) => (
    <section class:list={["section relative", i % 2 === 1 && "overflow-hidden"]}>
      <div class="container">
        <div class="section-container">
          <SectionIntro title={block.title} text={"intro" in block ? block.intro : undefined} />

          <div class="section-content">
            {block.type === "cards" && (
              <div class={`grid gap-4 ${gridCols(block.columns)}`}>
                {block.items.map((item) => (
                  <article class="card-tile">
                    <Icon name={item.icon} size={56} class="mb-6" />
                    <h3 class="text-h5-sm font-bold">{item.title}</h3>
                    <p class="mt-3 text-text-dark">{item.text}</p>
                  </article>
                ))}
              </div>
            )}

            {block.type === "groups" && (
              <div class={`grid gap-4 ${gridCols(block.columns)}`}>
                {block.items.map((item) => (
                  <article class="card-tile">
                    <Icon name={item.icon} size={56} class="mb-6" />
                    <h3 class="text-h5-sm font-bold">{item.title}</h3>
                    <ul class="stars-list mt-5 text-text-dark">
                      {item.list.map((li) => (
                        <li>{li}</li>
                      ))}
                    </ul>
                  </article>
                ))}
              </div>
            )}

            {block.type === "steps" && (
              <ol class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                {block.items.map((step, n) => (
                  <li class="card-tile relative overflow-hidden">
                    <span class="t-stroke block leading-none font-extrabold text-transparent text-[4.5rem]" aria-hidden="true">
                      {String(n + 1).padStart(2, "0")}
                    </span>
                    <h3 class="text-h5-sm font-bold mt-2">{step.title}</h3>
                    <p class="mt-3 text-text-dark">{step.text}</p>
                  </li>
                ))}
              </ol>
            )}

            {block.type === "chips" && (
              <div>
                <ul class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto">
                  {block.items.map((chip) => (
                    <li class="bg-body border border-border px-5 py-2.5 rounded-full text-lg font-semibold text-white flex items-center gap-x-2">
                      <svg class="shrink-0" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <circle cx="10" cy="10" r="9" stroke="var(--color-primary)" stroke-width="1.5" />
                        <path d="m6 10.2 2.8 2.8L14 7.6" stroke="var(--color-primary)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {chip}
                    </li>
                  ))}
                </ul>
                {block.footnote && <p class="mt-10 text-center text-h6-sm text-text mx-auto max-w-3xl">{block.footnote}</p>}
              </div>
            )}

            {block.type === "tabs" && <Tabs tabs={block.tabs} />}
          </div>
        </div>
      </div>
      {i % 2 === 1 && <GradientBlob />}
    </section>
  ))
}
