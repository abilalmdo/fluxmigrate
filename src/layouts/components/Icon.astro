---
interface Props {
  /** key of /public/images/icons/<name>.svg — generated by tools/images */
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 56, class: className } = Astro.props;
---

<img
  src={`/images/icons/${name}.svg`}
  width={size}
  height={size}
  alt=""
  loading="lazy"
  decoding="async"
  class={className}
/>
