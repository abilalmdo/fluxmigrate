---
import config from "@/config/config.json";
import OfficeList from "@/components/OfficeList.astro";
import PageHero from "@/components/PageHero.astro";
import { contactPage as c } from "@/data/content";
import Base from "@/layouts/Base.astro";
import { phone, telHref } from "@/lib/contact";
import { breadcrumbSchema, canonicalFor, pageSchema } from "@/lib/site";

const canonical = canonicalFor("/contact");
const { contact_form_action, footer_email } = config.params;
---

<Base
  title={c.title}
  description={c.description}
  schema={[breadcrumbSchema("Contact", canonical), pageSchema("ContactPage", "Contact", canonical, c.description)]}
>
  <PageHero h1={c.h1} subtitle={c.subtitle} image={{ src: c.heroImage, alt: c.heroAlt }} />

  <section class="section pt-0">
    <div class="container">
      <!-- phone card, form, offices: in that order on a phone; on desktop the form spans the
           right two-thirds and the two cards stack on the left -->
      <div class="grid gap-x-10 gap-y-6 lg:grid-cols-12 lg:grid-rows-[auto_1fr]">
        <div class="card-tile self-start lg:col-span-4 lg:col-start-1 lg:row-start-1">
          <h2 class="text-h5-sm font-bold">Prefer to talk?</h2>
          <p class="mt-3 text-text-dark">Call and speak with one of our specialists, or write to us and tell us about your environment.</p>
          <a class="link mt-6 inline-block text-lg" href={telHref}>{phone.display}</a>
          <p class="mt-1 text-sm text-text-dark">{phone.hours}</p>
          <a class="link mt-4 inline-block" href={`mailto:${footer_email}`}>{footer_email}</a>
        </div>

        <div class="lg:col-span-8 lg:col-start-5 lg:row-span-2 lg:row-start-1">
          <div class="p-8 md:p-10 bg-white/5 rounded-3xl corner-squircle">
            <form id="contact-form" action={contact_form_action} method="POST" class="grid gap-5">
              <input type="hidden" name="ts" value="" />
              <div class="hp-field" aria-hidden="true">
                <label for="hp_url">Leave this field empty</label>
                <input id="hp_url" name="hp_url" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label class="field-label" for="name">Name</label>
                  <input class="form-field" id="name" name="name" type="text" maxlength="100" autocomplete="name" required />
                </div>
                <div>
                  <label class="field-label" for="company">Company</label>
                  <input class="form-field" id="company" name="company" type="text" maxlength="150" autocomplete="organization" required />
                </div>
                <div>
                  <label class="field-label" for="email">Business Email</label>
                  <input class="form-field" id="email" name="email" type="email" maxlength="254" autocomplete="email" required />
                </div>
                <div>
                  <label class="field-label" for="role">Role</label>
                  <input class="form-field" id="role" name="role" type="text" maxlength="100" autocomplete="organization-title" />
                </div>
              </div>

              <div>
                <label class="field-label" for="need">What do you need?</label>
                <select class="form-field" id="need" name="need">
                  {c.needs.map((n) => <option>{n}</option>)}
                </select>
              </div>

              <div>
                <label class="field-label" for="env">Technology Environment</label>
                <input class="form-field" id="env" name="env" type="text" maxlength="300" placeholder="e.g. AWS, Kubernetes, VMware..." />
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label class="field-label" for="count">Number of Engineers Required</label>
                  <select class="form-field" id="count" name="count">
                    {c.engineers.map((n) => <option>{n}</option>)}
                  </select>
                </div>
                <div>
                  <label class="field-label" for="engagement">Engagement Type</label>
                  <select class="form-field" id="engagement" name="engagement">
                    {c.engagements.map((n) => <option>{n}</option>)}
                  </select>
                </div>
              </div>

              <div>
                <label class="field-label" for="details">Tell us about your requirements</label>
                <textarea class="form-field" id="details" name="details" rows="5" maxlength="5000"></textarea>
              </div>

              <!-- Self-hosted captcha: main.js fetches a question from /contact-captcha.php and reveals this -->
              <div id="captcha-field" hidden>
                <label class="field-label" for="captcha" id="captcha-label">Security question</label>
                <input type="hidden" name="captcha_token" value="" />
                <input class="form-field" id="captcha" name="captcha" type="text" maxlength="20" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="captcha-hint" />
                <p id="captcha-hint" class="mt-2 text-sm text-text-dark">A quick check that you are a person. Digits or words both work.</p>
              </div>
              <noscript>
                <p class="form-note">This form's spam check needs JavaScript. Please turn it on, or email us at <a class="link" href={`mailto:${footer_email}`}>{footer_email}</a>.</p>
              </noscript>

              <button type="submit" class="btn btn-primary w-full py-4 text-lg font-medium">Submit</button>
              <p class="text-center text-sm">We reply within 1 business day.</p>
            </form>

            <div id="form-status" class="form-error mt-6" role="alert" tabindex="-1">
              We couldn't send your message. Please check the form and try again, or email
              <a class="link" href={`mailto:${footer_email}`}>{footer_email}</a>.
            </div>
          </div>
        </div>

        <div class="card-tile self-start lg:col-span-4 lg:col-start-1 lg:row-start-2">
          <h2 class="text-h5-sm font-bold">Our offices</h2>
          <OfficeList class="mt-5" />
        </div>
      </div>
    </div>
  </section>
</Base>
