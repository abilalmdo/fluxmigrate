---
import HeroDecor from "@/components/HeroDecor.astro";
import { notFound } from "@/data/content";
import Base from "@/layouts/Base.astro";
---

<Base title={notFound.title} description="The page you requested was not found on fluxmigrate.com." noindex>
  <section class="section-ph text-center relative overflow-hidden">
    <HeroDecor id="nf" />
    <div class="container relative">
      <span class="text-[6rem] lg:text-[8rem] block font-bold text-primary leading-none" aria-hidden="true">404</span>
      <h1 class="h2 mt-4 mb-4">Page not found</h1>
      <p class="mx-auto max-w-xl">
        The address you followed does not match anything on fluxmigrate.com. The links below cover everything on the site.
      </p>
      <div class="mt-8 flex gap-4 justify-center flex-wrap">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/contact.html" class="btn btn-outline">Talk to a specialist</a>
      </div>

      <div class="mt-16 grid gap-4 md:grid-cols-3 text-left max-w-5xl mx-auto">
        {
          notFound.links.map((col) => (
            <div class="card-tile">
              <h2 class="text-h6 font-bold mb-4">{col.title}</h2>
              <ul>
                {col.items.map((l) => (
                  <li class="mb-2"><a class="footer-link" href={l.href}>{l.name}</a></li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
