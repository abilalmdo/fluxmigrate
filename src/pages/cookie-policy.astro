---
import PageHero from "@/components/PageHero.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import config from "@/config/config.json";
import { cookiePolicy as p } from "@/data/consent";
import Base from "@/layouts/Base.astro";
import { breadcrumbSchema, canonicalFor, pageSchema } from "@/lib/site";

const canonical = canonicalFor(`/${p.slug}`);
const schema = [breadcrumbSchema("Cookie Policy", canonical), pageSchema("WebPage", "Cookie Policy", canonical, p.description)];
---

<Base title={p.title} description={p.description} schema={schema}>
  <PageHero h1={p.h1} subtitle={p.subtitle} />

  <section class="section relative pt-0">
    <div class="container">
      <div class="mx-auto max-w-4xl grid gap-6">
        <article class="card-tile">
          <h2 class="text-h5-sm font-bold">{p.summaryTitle}</h2>
          <ul class="stars-list mt-5 text-text-dark">
            {p.summary.map((s) => <li>{s}</li>)}
          </ul>
          <p class="mt-6 text-sm text-text-dark">Last updated: {p.updated}</p>
        </article>

        <article class="card-tile" id="stored">
          <h2 class="text-h5-sm font-bold">{p.inventoryTitle}</h2>
          <p class="mt-3 text-text-dark">{p.inventoryIntro}</p>
          <ul class="mt-6 grid gap-4">
            {
              p.inventory.map((row) => (
                <li class="rounded-2xl border border-border bg-body/60 p-5">
                  <h3 class="font-mono text-lg font-semibold text-white">{row[0]}</h3>
                  <dl class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-[auto_1fr]">
                    {p.inventoryHead.slice(1).map((label, i) => (
                      <>
                        <dt class="text-sm uppercase tracking-wider text-primary font-semibold">{label}</dt>
                        <dd class="text-text-dark">{row[i + 1]}</dd>
                      </>
                    ))}
                  </dl>
                </li>
              ))
            }
          </ul>
        </article>

        <article class="card-tile">
          <h2 class="text-h5-sm font-bold">{p.formsTitle}</h2>
          <p class="mt-3 text-text-dark">{p.forms}</p>
        </article>

        <article class="card-tile">
          <h2 class="text-h5-sm font-bold">{p.thirdTitle}</h2>
          <p class="mt-3 text-text-dark">{p.third}</p>
        </article>

        <article class="card-tile scroll-mt-28" id="settings">
          <h2 class="text-h5-sm font-bold">{p.changeTitle}</h2>
          <p class="mt-3 text-text-dark">{p.change}</p>
          <button type="button" class="btn btn-primary mt-6" data-consent-open>{p.changeButton}</button>
        </article>

        <article class="card-tile">
          <h2 class="text-h5-sm font-bold">{p.contactTitle}</h2>
          <p class="mt-3 text-text-dark">
            {p.contact}{" "}<a class="link underline" href={`mailto:${config.params.footer_email}`}>{config.params.footer_email}</a>.
          </p>
        </article>
      </div>
    </div>
  </section>
</Base>
