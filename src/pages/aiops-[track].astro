---
import CtaBand from "@/components/CtaBand.astro";
import GradientBlob from "@/components/GradientBlob.astro";
import Icon from "@/components/Icon.astro";
import PageHero from "@/components/PageHero.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import { aiops, type AiopsTrack } from "@/data/aiops";
import { deliverables, serviceDetail, stack } from "@/data/aiops-detail";
import Base from "@/layouts/Base.astro";
import { breadcrumbSchema, canonicalFor, serviceSchema } from "@/lib/site";

export function getStaticPaths() {
  return aiops.tracks.map((track) => ({ params: { track: track.id }, props: { track } }));
}

const { track } = Astro.props as { track: AiopsTrack };
const detail = serviceDetail[track.id];
const others = aiops.tracks.filter((t) => t.id !== track.id);
const canonical = canonicalFor(`/aiops-${track.id}`);
const title = `${track.name} Services | FluxMigrate`;
const description = `${track.tagline} Services: ${track.services.map((s) => s.name).join("; ")}.`;
const schema = [
  breadcrumbSchema(track.name, canonical, [{ name: aiops.navLabel, url: canonicalFor(`/${aiops.slug}`) }]),
  serviceSchema(track.name, canonical, description),
];
---

<Base title={title} description={description} schema={schema}>
  <PageHero
    h1={`**${track.name}** services`}
    subtitle={track.tagline}
    cta={{ label: `Talk to a ${track.name} Specialist`, href: "/contact.html" }}
    image={{ src: track.image, alt: track.imageAlt }}
  />

  <!-- Services -->
  <section class="section relative">
    <div class="container">
      <div class="section-container">
        <SectionIntro
          title={`Five **${track.name}** services`}
          text="Each service can be taken alone. They share telemetry, policy and runbooks when combined."
        />
        <div class="section-content grid gap-6">
          {
            track.services.map((s, i) => (
              <article id={`service-${i + 1}`} class="card-tile scroll-mt-28 grid lg:grid-cols-5 gap-8">
                <div class="lg:col-span-3">
                  <span class="t-stroke block leading-none font-extrabold text-transparent text-[4.5rem]" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <h3 class="text-h5-sm font-bold mt-2">{s.name}</h3>
                  <p class="mt-3 text-text-dark">{s.text}</p>
                  <div class="mt-6 rounded-2xl border border-dashed border-primary/50 p-5">
                    <p class="text-sm tracking-wider uppercase text-primary font-semibold mb-2">{aiops.scenarioLabel}</p>
                    <p class="text-text-dark">{detail[i].scenario}</p>
                  </div>
                </div>
                <div class="lg:col-span-2">
                  <h4 class="text-sm tracking-wider uppercase text-white font-semibold mb-4">Core capabilities</h4>
                  <ul class="stars-list text-text-dark">
                    {detail[i].capabilities.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Deliverables -->
  <section class="section relative overflow-hidden">
    <div class="container">
      <div class="section-container">
        <SectionIntro
          title="What you **receive**"
          text="Every service is built as a local-first lab, then extended to your private cloud and to AWS, Azure or GCP."
        />
        <div class="section-content">
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            {
              deliverables.map((d) => (
                <article class="card-tile">
                  <Icon name={d.icon} size={56} class="mb-6" />
                  <h3 class="text-h5-sm font-bold">{d.title}</h3>
                  <p class="mt-3 text-text-dark">{d.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
    <GradientBlob />
  </section>

  <!-- Safety + stack -->
  <section class="section relative">
    <div class="container">
      <div class="section-container">
        <SectionIntro title={aiops.guardrailsTitle} text="Rules every AIOps action follows, in every track." />
        <div class="section-content">
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            {
              aiops.guardrails.map((g) => (
                <article class="card-tile">
                  <Icon name={g.icon} size={56} class="mb-6" />
                  <h3 class="text-h5-sm font-bold">{g.title}</h3>
                  <p class="mt-3 text-text-dark">{g.text}</p>
                </article>
              ))
            }
          </div>
          <h3 class="mt-16 mb-6 text-center text-h5-sm font-bold">Typical technology base</h3>
          <ul class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto">
            {
              stack.map((chip) => (
                <li class="bg-body border border-border px-5 py-2 rounded-full font-semibold text-white">{chip}</li>
              ))
            }
          </ul>
          <p class="mt-6 text-center text-text-dark">Adapted to the tools you already run.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Other tracks -->
  <section class="section relative overflow-hidden">
    <div class="container">
      <div class="section-container">
        <SectionIntro title="Other **AIOps tracks**" text="Combine tracks to share telemetry, policy and runbooks." />
        <div class="section-content">
          <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            {
              others.map((o) => (
                <li class="card-tile flex flex-col">
                  <Icon name={o.icon} size={48} class="mb-4" />
                  <h3 class="text-h6-sm font-bold">{o.name}</h3>
                  <a
                    href={`/aiops-${o.id}.html`}
                    class="mt-4 inline-flex items-center gap-2 font-semibold text-white hover:text-primary transition-colors"
                  >
                    View services
                    <span class="sr-only">: {o.name}</span>
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4 10h11m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mt-10 text-center">
            <a class="btn btn-outline" href="/aiops-services.html">All AIOps services</a>
          </p>
        </div>
      </div>
    </div>
    <GradientBlob />
  </section>

  <CtaBand
    title={`Start with **${track.name}?**`}
    text="Tell us what you run and where operations hurt most. We will suggest where to begin."
    button={{ label: "Talk to an AIOps Specialist", href: "/contact.html" }}
  />
</Base>
